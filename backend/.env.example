# GitHub Personal Access Token (metadata + issue/PR history, avoids 60 req/hr limit)
GITHUB_PAT=your_token_here

# OpenRouter — powers both embeddings (nvidia/nemotron-3-embed-1b:free) and chat
OPENROUTER_API_KEY=your_key_here

# Storage mode: "ram" for guest sessions, "disk" for ChromaDB persistence
STORAGE_MODE=disk
