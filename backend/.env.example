# Copy to backend/.env and fill in. Never commit .env.

# ── Required for core features ────────────────────────────────────────────

# GitHub Personal Access Token — repo metadata, PR history, issues, gatekeeper.
# GitHub's GraphQL API rejects unauthenticated calls, so history/issues fail without it.
GITHUB_PAT=your_token_here

# OpenRouter key — embeddings (nvidia/nemotron-3-embed-1b:free) and chat (minimax/minimax-m3:free).
OPENROUTER_API_KEY=your_key_here

# ── Required for GitHub sign-in (Phase 9) ─────────────────────────────────

# OAuth App from https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL to register: http://127.0.0.1:8000/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=your_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Signs session tokens. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string

# Encrypts stored GitHub tokens. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_fernet_key

# ── Optional (defaults shown) ─────────────────────────────────────────────

# Where the browser returns after sign-in. No trailing slash. Must be the exact origin you open.
FRONTEND_URL=http://localhost:5173

# SQLite file for users/memory, relative to the folder uvicorn runs from.
DB_PATH=./devlens.db

# ChromaDB vector store folder, relative to the folder uvicorn runs from.
CHROMA_PATH=./chroma_db
